# Required
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chatapi
AUDIO_BUCKET_NAME=your-audio-bucket
TRANSCRIBE_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/transcription-queue
HUGGINGFACE_TOKEN=hf_...

# Optional (defaults shown)
AWS_REGION=us-east-1
MATCHING_THRESHOLD=0.25
SQS_VISIBILITY_TIMEOUT=600
SQS_VISIBILITY_EXTENSION_INTERVAL=300
SPEECHBRAIN_CHECKPOINT=speechbrain/spkrec-ecapa-voxceleb
SPEECHBRAIN_REVISION=3c54e95
SPEECHBRAIN_CACHE=/app/speechbrain_model
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1

# Dev — capture pipeline output to S3 for local replay via dev_worker.py
# Files land at s3://<AUDIO_BUCKET_NAME>/<prefix>/<job_id>/{transcribe,diarize,matcher}.json
#DEV_CAPTURE_FIXTURES_S3_PREFIX=dev-fixtures
