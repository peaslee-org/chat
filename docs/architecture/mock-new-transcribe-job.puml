@startuml mock-new-transcribe-job
!theme plain

skinparam {
  BackgroundColor #F8FAFC
  ArrowColor #4B5563
  ArrowFontSize 9
  ArrowFontColor #374151
  SequenceArrowThickness 1.3
  SequenceGroupBodyBackgroundColor #F8FAFC
  SequenceGroupBorderColor #9CA3AF
  SequenceGroupFontSize 10
  SequenceBoxBackgroundColor #F1F5F9
  SequenceBoxBorderColor #9CA3AF
  SequenceLifeLineBorderColor #9CA3AF
  SequenceParticipantBackgroundColor #FFFFFF
  SequenceParticipantBorderColor #9CA3AF
  SequenceParticipantFontSize 11
}

skinparam note {
  BorderColor #D1D5DB
  BackgroundColor #F9FAFB
  FontSize 9
}

title Mock Transcription Job — Sequence Diagram\\n(VITE_MOCK_API=true; user already authenticated)

actor "User" as user
participant "Vue SPA\\n(NewJobForm\\n+ transcribe store)" as spa
participant "trafficRecorder.ts\\n(axios interceptor)" as recorder
participant "MSW\\n(Mock Service Worker)\\n+ traffic.json" as msw
participant "chat-api\\n(real, record phase only)" as realApi
participant "S3" as s3
participant "transcription-worker\\n(ECS GPU)" as worker

note over msw
  All API calls are intercepted
  by MSW in replay mode.
  Responses come from traffic.json
  (captured real session), keyed
  by method + path (last entry wins).
  Presigned S3 PUTs use a separate
  blanket wildcard handler.
end note

== Phase 0: Record phase (prerequisite — done once against a live backend) ==

note over user, realApi
  Run against any build with a live backend.
  In browser DevTools: localStorage.setItem('__recordTraffic', 'true') then reload.
end note

user -> spa : use app normally\\n(walk full UI flow to mock)
spa -> recorder : every axios call via apiClient
recorder -> realApi : forward request\\n(with real auth headers)
realApi --> recorder : real API response
recorder -> recorder : log {method, path,\\nstatus, body}\\nto localStorage[__trafficLog]
recorder --> spa : response (transparent)

note right of recorder
  Presigned S3 PUTs bypass
  apiClient — not captured
  here. MSW stubs them with
  a wildcard 200 handler.
end note

user -> spa : window.__traffic.export()\\nin DevTools console
spa -> user : downloads traffic.json
user -> user : place in\\nsrc/mocks/traffic.json\\nset VITE_MOCK_API=true

== Phase 0b: Optional — Capture real worker fixtures to S3 ==

note over worker, s3
  Set DEV_CAPTURE_FIXTURES_S3_PREFIX=dev-fixtures on the ECS task.
  After each pipeline stage, _maybe_capture() uploads fixture JSON to
  AUDIO_BUCKET_NAME at <prefix>/<job_id>/{stage}.json.
  Download and place in DEV_FIXTURES_DIR for dev_worker.py replay.
end note

worker -> worker : run AWS Transcribe poll\\n→ parse words
worker -> s3 : PUT dev-fixtures/<job_id>/transcribe.json\\n(raw AWS Transcribe output)
s3 --> worker : ok

worker -> worker : pyannote diarization\\n(CUDA GPU)
worker -> s3 : PUT dev-fixtures/<job_id>/diarize.json\\n(speaker turns with start/end)
s3 --> worker : ok

worker -> worker : align words + match speakers
worker -> s3 : PUT dev-fixtures/<job_id>/matcher.json\\n(turns with speaker_profile_id + cosine_dist)
s3 --> worker : ok

note over worker, s3
  dev_worker.py loads these fixtures from DEV_FIXTURES_DIR
  to replay the pipeline without ML models or real AWS calls.
  Any missing stage falls back to synthetic data.
end note

== Phase 1: Create job record + get upload URL ==

note over user, msw
  Replay mode: VITE_MOCK_API=true. Real backend and worker not involved.
end note

user -> spa : fill form\\n(audio file, language,\\nspeaker count, speaker IDs)\\nclick Submit

spa -> recorder : POST /api/v1/transcribe/jobs\\n{speaker_count_hint, language, speaker_ids?}
recorder -> msw : intercept
msw --> recorder : 202 {job_id, upload_url}\\n(from traffic.json)
recorder --> spa : 202 {job_id, upload_url}

spa -> spa : add job to list\\n(status=pending)

== Phase 2: Upload audio directly (presigned URL) ==

spa -> msw : PUT https://*.s3.amazonaws.com/*\\n(raw audio bytes, no auth header)
note right of msw
  Blanket wildcard handler:
  http.put('https://*.s3.amazonaws.com/*')
  No body validation; returns 200
  immediately regardless of file.
end note
msw --> spa : 200 OK

== Phase 3: Confirm upload — initial 409 (samples still embedding) ==

spa -> recorder : POST /api/v1/transcribe/jobs/{job_id}/confirm
recorder -> msw : intercept
msw --> recorder : 409 Conflict\\n{"detail": "Speaker samples are still\\nprocessing — try again shortly"}
recorder --> spa : 409

spa -> spa : park job in pendingConfirms map\\nwait for sample polling to resolve

== Phase 4: Speaker sample polling (parallel to job confirm retry) ==

loop every 3 s (up to 200 polls)
  spa -> recorder : GET /api/v1/transcribe/speaker-profiles/{profile_id}\\n(polling sample embedding status)
  recorder -> msw : intercept
  msw --> recorder : 200 {samples: [{status: "processing", ...}]}
  recorder --> spa : 200

  note right of spa
    Store checks if all
    samples are ready or
    failed. Keeps polling
    while any are "processing".
  end note
end

spa -> recorder : GET /api/v1/transcribe/speaker-profiles/{profile_id}
recorder -> msw : intercept
msw --> recorder : 200 {samples: [{status: "ready", ...}]}
recorder --> spa : 200 — all samples ready

spa -> spa : tryPendingConfirms()\\n(auto-retry parked confirms)

== Phase 5: Confirm upload — retry succeeds ==

spa -> recorder : POST /api/v1/transcribe/jobs/{job_id}/confirm
recorder -> msw : intercept
msw --> recorder : 202 Accepted (null body)\\n(from traffic.json)
recorder --> spa : 202

spa -> spa : update job status → transcribing\\nstartPolling(job_id)

== Phase 6: Client polls for status ==

loop every 10 s (POLL_INTERVAL_NORMAL)\\n(or 60 s if worker_paused=true)
  spa -> recorder : GET /api/v1/transcribe/jobs/{job_id}
  recorder -> msw : intercept
  msw --> recorder : 200 {status: "transcribing" | "matching", worker_paused: false}
  note right of msw
    Dedup by method+path:
    repeated polls return the
    same captured response.
    Multiple "matching" entries
    all resolve identically.
  end note
  recorder --> spa : 200 {status, ...}
  spa -> spa : update job in list
end

== Phase 7: Poll detects completion ==

spa -> recorder : GET /api/v1/transcribe/jobs/{job_id}
recorder -> msw : intercept
msw --> recorder : 200 {status: "complete",\\nmatched_speaker_count, total_segment_count}
recorder --> spa : 200 {status: "complete", ...}

spa -> spa : stopPolling(job_id)

== Phase 8: Load transcript ==

spa -> recorder : GET /api/v1/transcribe/jobs/{job_id}/transcript
recorder -> msw : intercept
msw --> recorder : 200 {segments: [22 static segments\\nwith anonymous_label, start, end, text],\\ntranscript_url: null}
note right of msw
  Static captured transcript
  (real poetry dialogue).
  speaker_name: null on all
  segments (profile join
  not resolved in capture).
end note
recorder --> spa : 200 {segments, transcript_url}

spa -> recorder : GET /api/v1/transcribe/jobs/{job_id}/turn-distances
recorder -> msw : intercept
msw --> recorder : 200 {turn_distances: [...\\nfixed cosine distances]}
recorder --> spa : 200

spa --> user : render TranscriptDisplay\\n(speaker labels + timestamps)

note over spa, msw
  No actual ECS worker, GPU diarization, or AWS Transcribe involved in replay.
  All processing is simulated by static traffic.json responses.
  For a full end-to-end offline loop (real API + dev_worker.py, no ML),
  see docs/mock-api.md — "Fully offline local dev mode".
end note

@enduml
