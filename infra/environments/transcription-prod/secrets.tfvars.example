# Copy to secrets.tfvars and fill in real values.
# Never commit secrets.tfvars.

# ARN of the Secrets Manager secret that holds the HuggingFace read token.
# Required for pyannote gated model access.
# Create with: aws secretsmanager create-secret --name huggingface-token --secret-string "hf_..."
huggingface_token_secret_arn = ""

# Email address for CloudWatch DLQ alarm notifications.
# Leave empty to skip alarm creation.
alarm_email = ""
