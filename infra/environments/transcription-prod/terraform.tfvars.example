# Copy to terraform.tfvars (gitignored). Secrets go in secrets.tfvars — see secrets.tfvars.example.
environment                  = "prod"
worker_ami_id                = "ami-00000000000000000"
cors_allowed_origins         = ["https://chat.example.com", "http://localhost:5173"]
huggingface_token_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:transcription-prod/huggingface-token-XXXXXX"
# Email for the DLQ CloudWatch alarm. Leave empty to skip alarm creation.
alarm_email = ""
