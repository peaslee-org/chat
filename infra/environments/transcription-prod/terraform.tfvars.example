# Copy to terraform.tfvars (gitignored). No secret values live in Terraform: credentials are
# Secrets Manager ARNs, injected into the container by ECS.
environment                  = "prod"
cors_allowed_origins         = ["http://localhost:5173", "https://chat.peaslee.org", "https://aitools.peaslee.org"]
huggingface_token_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:transcription-prod/huggingface-token-XXXXXX"
# Email for the DLQ CloudWatch alarm. Leave empty to skip alarm creation.
alarm_email = ""
worker_cpu                   = 2048
worker_memory                = 6144
image_tag                    = "latest"
database_url_secret_arn      = "arn:aws:secretsmanager:us-east-1:123456789012:secret:transcription-prod/database-url-XXXXXX"
idle_exit_seconds            = 900     # must equal prod's gpu_idle_exit_seconds
max_lifetime_seconds         = 10800   # must equal prod's gpu_max_lifetime_seconds
