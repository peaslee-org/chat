VITE_COGNITO_DOMAIN=myapp.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your_client_id_here
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_SCOPE=openid email profile
VITE_API_BASE_URL=http://localhost:8000
# Set to true to intercept API calls with MSW (requires src/mocks/traffic.json — see README)
VITE_MOCK_API=false
# Local dev only (ignored in production builds): skip Cognito entirely and send no Authorization
# header — pair with DEV_AUTH_BYPASS=true in chat-api/.env
VITE_DEV_AUTH_BYPASS=false
