# App
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatapi

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# Bedrock
USE_MOCK_BEDROCK=false
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# Simulated latency for mock responses (seconds); useful for debugging timing issues
#MOCK_BEDROCK_DELAY_SECONDS=2.0

# Audio Transcription
AUDIO_BUCKET_NAME=your-audio-bucket-name
TRANSCRIBE_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/transcription-queue
MAX_CONCURRENT_JOBS=3
# Skip S3/SQS/Transcribe; jobs complete instantly with mock segments (uses local DB)
USE_MOCK_TRANSCRIPTION=false
# API base URL as seen by the browser; upload/download URLs point here in mock mode
#MOCK_UPLOAD_BASE_URL=http://localhost:8000
# Seconds spent in each mock job stage (transcribing → matching → complete)
#MOCK_JOB_TRANSCRIBING_DELAY_SECONDS=5.0
#MOCK_JOB_MATCHING_DELAY_SECONDS=3.0

# Local dev — fully offline mode (no Cognito, no S3, no SQS, no ML models needed)
# Set USE_MOCK_TRANSCRIPTION=true alongside these.
# DEV_AUTH_BYPASS=false          # Skip Cognito JWT validation entirely (never enable in prod)
# DEV_AUTH_USER_SUB=dev-user-001 # Cognito sub used for all requests when bypass is active
# LOCAL_STORAGE_PATH=/tmp/mock-audio  # Where uploaded audio files are stored on disk
# MOCK_WORKER_EXTERNAL=false     # Set true to skip in-process simulation; run dev_worker.py instead

# LangSmith (set LANGCHAIN_TRACING_V2=true and add your key to enable locally)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=chat-api
#LANGCHAIN_API_KEY=
